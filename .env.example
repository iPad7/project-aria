# cp .env.example .env
# 모든 값은 config.Settings 의 기본값을 override 한다(prefix: ARIA_).
# 로컬 기본값이 docker-compose.yml 과 일치하므로, 아래를 안 채워도 개발은 돌아간다.

# ⚠️ .env 는 **실행 디렉터리 기준**으로 읽힌다(env_file=".env"가 상대 경로).
#    api·워커는 repo 루트에서 띄울 것. apps/aria 에서 돌리는 alembic 은 이 파일을
#    읽지 않으므로, DB URL이 기본값과 다르면 그쪽엔 환경변수로 줘야 한다.

ARIA_DATABASE_URL=postgresql+psycopg://aria:aria@localhost:5432/aria
ARIA_REDIS_URL=redis://localhost:6379/0
ARIA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 인증 — 운영에서는 반드시 override 할 것 (기본값은 의도적으로 안전하지 않다).
# 빈 값으로 두지 말 것: 빈 문자열도 "설정된 값"이라 기본값을 덮어쓰고 기동이 거부된다.
# ARIA_JWT_SECRET=

# ── 생성 (PersonaLLMPort 뒤) ────────────────────────────────────────────────
# 기본은 stub 이라 키·GPU 없이 로컬·CI가 그대로 돈다.
#   stub   : 캔드 응답
#   openai : OpenAI 호환 엔드포인트 (외부 OpenAI 또는 자체 vLLM — base_url만 다름)
ARIA_LLM_BACKEND=stub
ARIA_OPENAI_API_KEY=

# 외부 OpenAI를 쓸 때: base_url 을 비우면 api.openai.com
# ARIA_LLM_BACKEND=openai
# ARIA_LLM_MODEL=gpt-4o-mini

# 자체 vLLM 서빙(project-aria-inference)을 쓸 때:
# vLLM이 OpenAI 호환 API를 서빙하므로 어댑터는 같고 base_url만 바뀐다.
# 다른 머신(예: GPU 박스)이면 localhost 대신 그 머신의 LAN IP.
# ARIA_LLM_BACKEND=openai
# ARIA_LLM_BASE_URL=http://192.168.0.10:8000/v1
# ARIA_LLM_MODEL=A.X-4.0-Light-awq
# ARIA_OPENAI_API_KEY=not-needed

# ── 폴백 (NFR-REL-3) ────────────────────────────────────────────────────────
# 켜면 주 백엔드가 실패했을 때 진짜 OpenAI로 넘어간다(자체 서빙이 죽어도 응답 지속).
# 켠 채로 키가 없으면 기동을 거부한다 — 조용히 폴백 없이 도는 것보다 낫다.
# ARIA_LLM_FALLBACK_ENABLED=true
# ARIA_LLM_FALLBACK_MODEL=gpt-4o-mini

# ── 레거시 스켈레톤 ─────────────────────────────────────────────────────────
# persona_id -> 전용 sLLM base URL 라우팅. InferenceHttpClient 용이며 현재 미사용
# ("전용 sLLM 있으면 그쪽, 없으면 폴백" 합성은 후속). 위 ARIA_LLM_* 과 무관하다.
# ARIA_INFERENCE_BASE_URLS={"홍세현":"http://localhost:8001"}

# ── 이벤트 백본 / 워커 ──────────────────────────────────────────────────────
# 같은 그룹의 복제본을 늘리는 것이 곧 수평 확장이다(파티션이 나뉜다).
# ARIA_GENERATION_CONSUMER_GROUP=generation-workers
# at-least-once 재전달의 중복을 흡수하는 claim TTL(초). 재전달 창보다 길어야 한다.
# ARIA_DEDUP_TTL_SECONDS=3600

# ── idle 진행 (FR-IDLE) ─────────────────────────────────────────────────────
# 무채팅이 이만큼 지속되면 사연을 읽거나 자율발화한다.
# ARIA_IDLE_THRESHOLD_SECONDS=6.0
# 틱은 임계값보다 **짧아야** 한다 — 같거나 길면 idle 판정을 놓친다.
# ARIA_IDLE_TICK_SECONDS=3.0
# 한 틱에 살펴보는 방의 상한. 병렬화·샤딩은 부하 실측 후.
# ARIA_IDLE_ROOMS_PER_TICK=50
# 시청자가 없고 이만큼 조용한 방송은 진행 워커가 종료한다(초). 기본 30분.
# ARIA_ROOM_ABANDON_SECONDS=1800.0

# ── LLM 관측 (NFR-OBS-2 → Langfuse) ─────────────────────────────────────────
# 기본은 no-op 이라 키 없이 로컬·CI가 그대로 돈다.
# 키 발급: cloud.langfuse.com 가입 → 조직·프로젝트 생성 → Settings → API Keys.
# secret key 는 발급 시 한 번만 보여준다.
# ARIA_LANGFUSE_ENABLED=true
# ARIA_LANGFUSE_PUBLIC_KEY=pk-lf-...
# ARIA_LANGFUSE_SECRET_KEY=sk-lf-...
#
# ⚠️ host 는 **가입할 때 고른 리전**과 맞아야 한다. 안 맞으면 조용히 아무것도
#    안 찍힌다(어댑터가 예외를 삼키므로).
#      EU(기본) https://cloud.langfuse.com
#      US       https://us.cloud.langfuse.com
#      Japan    https://jp.cloud.langfuse.com
# ARIA_LANGFUSE_HOST=https://cloud.langfuse.com
#
# 과금 단위가 trace 가 아니라 observation 각각(span·generation·score)이다.
# 이 설계는 응답 1건이 ~3유닛이고 idle 루프가 계속 발화하므로 기본을 0.2로 둔다.
# 처음 배선을 확인할 때만 1.0 으로 올리고, 확인 뒤 되돌릴 것.
# ARIA_LANGFUSE_SAMPLE_RATE=0.2
# ARIA_LANGFUSE_ENVIRONMENT=development
